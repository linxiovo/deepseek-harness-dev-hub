#!/bin/sh
set -eu

# A PR comes from a branch. A push that only deletes refs or updates tags needs no checkout.
head=''
while read -r local_ref local_oid remote_ref remote_oid; do
  [ "$local_ref" = '(delete)' ] && continue
  case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac
  if [ -z "$head" ]; then head=$(git rev-parse --verify HEAD); fi
  if [ "$local_oid" != "$head" ]; then
    printf 'Pre-push: check out %s before pushing it to %s.\n' "$local_ref" "$remote_ref" >&2
    exit 1
  fi
done
[ -n "$head" ] || exit 0

require_clean_head() {
  current=$(git rev-parse --verify HEAD)
  changes=$(git status --porcelain=v1 --untracked-files=normal --ignore-submodules=none)
  if [ "$current" != "$head" ] || [ -n "$changes" ]; then
    printf 'Pre-push: use a clean worktree at the commit being pushed.\n' >&2
    exit 1
  fi
}

require_clean_head
printf 'Pre-push: running pnpm check for %s.\n' "$head" >&2
(cd "$(dirname "$0")/.." && pnpm run check </dev/null)
require_clean_head
